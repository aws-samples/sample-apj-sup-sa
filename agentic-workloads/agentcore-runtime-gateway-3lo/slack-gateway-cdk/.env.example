# Slack OAuth2 application credentials for the slack-mcp-server-provider.
# Copy this file to `.env` and fill in the real values. `.env` is gitignored.
#
# The Slack client id and secret are NOT set here. Store them in a pre-created
# AWS Secrets Manager secret (in the deploy account/region) as JSON, e.g.:
#     {"client_id":"...","client_secret":"..."}
# with the JSON keys "client_id" and "client_secret".
#
# The provider uses ClientSecretSource=EXTERNAL, so AgentCore Identity reads the
# client secret from your secret at runtime. Provide the full secret ARN (not just
# the name). The secret must also grant the AgentCore service principal
# secretsmanager:GetSecretValue via its resource policy (see README).

# ARN of the pre-created Secrets Manager secret holding the Slack credentials.
SLACK_SECRET_ARN=<<Enter SLACK_SECRET_ARN here>>

# Optional: suffix appended to account/region-scoped resource names to keep
# deployments collision-free. If omitted, a stable suffix is derived from the
# construct address.
# RESOURCE_SUFFIX=dev1

# Optional: Cognito hosted-UI domain prefix (must be globally unique across AWS).
# If omitted, defaults to "agentcore-gateway-slack-<suffix>".
# COGNITO_DOMAIN_PREFIX=agentcore-gateway-slack

# Optional: Bedrock model id the runtime agent uses. If omitted, defaults to
# global.anthropic.claude-sonnet-4-6. Ensure model access is enabled in your region.
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# The account comes from your active AWS credentials/profile. The region defaults to
# us-east-1; uncomment CDK_DEFAULT_REGION below to deploy elsewhere.
# CDK_DEFAULT_ACCOUNT=111122223333
# CDK_DEFAULT_REGION=us-east-1
