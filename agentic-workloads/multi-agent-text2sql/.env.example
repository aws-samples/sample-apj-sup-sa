# =============================================================================
# Multi-Agent Text2SQL - Environment Configuration
# Copy this file to `.env` and fill in your own values:  cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# AWS (required)
# -----------------------------------------------------------------------------
# Region used for Amazon Bedrock, Athena, and Glue.
AWS_DEFAULT_REGION=us-east-1

# Optional: named AWS CLI profile to use. Leave unset to use the default
# credential chain (env vars / instance role / SSO).
# AWS_PROFILE=default

# -----------------------------------------------------------------------------
# Amazon Athena (required)
# -----------------------------------------------------------------------------
# S3 location where Athena writes query results. The bucket must exist and be
# in AWS_DEFAULT_REGION. The app fails fast on startup if this is not set.
ATHENA_OUTPUT_LOCATION=s3://your-athena-results-bucket/query-results/

# -----------------------------------------------------------------------------
# Model selection (optional)
# -----------------------------------------------------------------------------
# Override the default model. Must be one of the IDs listed in app.py.
# DEFAULT_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# -----------------------------------------------------------------------------
# OpenSearch / RAG (optional)
# -----------------------------------------------------------------------------
# Leave OPENSEARCH_ENDPOINT unset to run WITHOUT the RAG agent (schema-doc
# retrieval). Set it to enable RAG. Serverless (aoss) uses SigV4 with your AWS
# credentials; a managed domain can use basic auth via the username/password.
# OPENSEARCH_ENDPOINT=https://your-collection.us-east-1.aoss.amazonaws.com
# OPENSEARCH_INDEX=bird-description
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=

# -----------------------------------------------------------------------------
# Semantic cache / Valkey (optional)
# -----------------------------------------------------------------------------
# The semantic cache node is disabled by default (commented out in
# agents/multi_agent/multi_agent_text2sql.py). To try it, run a local Valkey
# (e.g. `docker run -p 6379:6379 valkey/valkey`) and enable the node.
VALKEY_ENDPOINT=localhost
VALKEY_PORT=6379

# -----------------------------------------------------------------------------
# Logging (optional)
# -----------------------------------------------------------------------------
# DEBUG_LOGGING=false
# LOG_LEVEL=INFO
