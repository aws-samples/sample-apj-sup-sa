# For local development:
VITE_BOT_START_URL="http://localhost:7860/start"

# For Pipecat Cloud:
### (replace {agentName} with your agent name):
# VITE_BOT_START_URL="https://api.pipecat.daily.co/v1/public/{agentName}/start"

### Create a public API key at https://pipecat.daily.co/{yourOrgName}/settings/keys
### Note: In production, these values will be exposed in the browser bundle.
### For production apps, consider using a backend proxy to protect secrets.
# VITE_BOT_START_PUBLIC_API_KEY="pk_..."

# Local Daily demo mode. To benchmark SmallWebRTC, set this to `smallwebrtc`
# and start the bot server in its default WebRTC mode instead of `-t daily`.
VITE_CLAIMPILOT_TRANSPORTS=daily
VITE_CLAIMPILOT_DEFAULT_TRANSPORT=daily
VITE_CLAIMPILOT_PHONE_CONNECTION_DELAY_MS=3500
VITE_CLAIMPILOT_SECURE_LINK_DELAY_MS=10000

# ClaimPilot companion-app event stream from server/bot.py function handlers.
VITE_APP_EVENT_WS_URL=ws://127.0.0.1:8787

# ClaimPilot Deepgram Voice Agent relay. The browser connects to this local
# relay so the Deepgram API key stays server-side.
VITE_CLAIMPILOT_VOICE_AGENT_WS_URL=ws://127.0.0.1:8790
