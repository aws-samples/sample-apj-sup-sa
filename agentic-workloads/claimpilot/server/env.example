# Copy this file to .env and fill in your API keys. Do not commit .env.

# Daily / Pipecat transport
DAILY_API_KEY=<daily-api-key>
# DAILY_ROOM_URL= # Optional: leave empty to create a new room per session.

# Deepgram STT/TTS
DEEPGRAM_API_KEY=<deepgram-api-key>
DEEPGRAM_VOICE_ID=aura-2-helena-en

# AWS Bedrock conversational LLM
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_SESSION_TOKEN=<aws-session-token-if-needed>
AWS_REGION=ap-southeast-2
AWS_BEDROCK_MODEL=us.anthropic.claude-3-5-haiku-20241022-v1:0

# Logging
LOG_LEVEL=INFO
CLAIMPILOT_LOG_LEVEL=INFO

# Voice runtime
# cascade_fast: reliable Pipecat + Bedrock + Deepgram path.
# flux_safe: Deepgram Flux turn detection with safer demo defaults.
# voice_agent_poc: separate Deepgram Voice Agent relay path.
CLAIMPILOT_VOICE_RUNTIME=cascade_fast
USE_FLUX=false
CLAIMPILOT_USE_FLUX_TURN_EVENTS=true
CLAIMPILOT_FLUX_EAGER_EOT_THRESHOLD=0.45
CLAIMPILOT_FLUX_EOT_THRESHOLD=0.55
CLAIMPILOT_FLUX_EOT_TIMEOUT_MS=800
CLAIMPILOT_FLUX_MIN_CONFIDENCE=
CLAIMPILOT_DEEPGRAM_LANGUAGE=en
CLAIMPILOT_DEEPGRAM_STT_MODEL=nova-3-general
CLAIMPILOT_DEEPGRAM_TTS_MODEL=aura-2-helena-en
CLAIMPILOT_TTS_PLAYBACK_RATE=1.12
CLAIMPILOT_USER_TURN_STOP_TIMEOUT=0.45
CLAIMPILOT_USER_SPEECH_TIMEOUT=0.30
CLAIMPILOT_DEEPGRAM_TTFS_P99=0.35
CLAIMPILOT_USE_SPEECH_TIMEOUT_TURN_STRATEGY=true
CLAIMPILOT_VAD_CONFIDENCE=0.68
CLAIMPILOT_VAD_START_SECS=0.10
CLAIMPILOT_VAD_STOP_SECS=0.25
CLAIMPILOT_VAD_MIN_VOLUME=0.50
CLAIMPILOT_DEEPGRAM_ENDPOINTING_MS=120
CLAIMPILOT_DEEPGRAM_UTTERANCE_END_MS=1000
CLAIMPILOT_DEEPGRAM_VAD_STOP_SECS=0.25
CLAIMPILOT_DEEPGRAM_VAD_EVENTS=false
CLAIMPILOT_STT_SHOULD_INTERRUPT=false

# Optional Deepgram-native Voice Agent relay
CLAIMPILOT_VOICE_AGENT_THINK_PROVIDER=open_ai
CLAIMPILOT_VOICE_AGENT_THINK_MODEL=gpt-4o-mini
CLAIMPILOT_VOICE_AGENT_LISTEN_MODEL=flux-general-en
CLAIMPILOT_VOICE_AGENT_SPEAK_MODEL=aura-2-helena-en
CLAIMPILOT_VOICE_AGENT_RELAY_HOST=127.0.0.1
CLAIMPILOT_VOICE_AGENT_RELAY_PORT=8790
CLAIMPILOT_VOICE_AGENT_TEST_UTTERANCE=

# Optional SageMaker-hosted Deepgram models
USE_SAGEMAKER=false
SAGEMAKER_STT_ENDPOINT_NAME=
SAGEMAKER_TTS_ENDPOINT_NAME=

# ClaimPilot UI event bridge
CLAIMPILOT_UI_EVENT_HOST=127.0.0.1
CLAIMPILOT_UI_EVENT_PORT=8787

# ClaimPilot state and AWS artifacts
CLAIMPILOT_PERSIST_DEBOUNCE_MS=250
CLAIMPILOT_CLAIM_ID_PREFIX=CLM
CLAIMPILOT_CLAIM_ID_START=1049
CLAIMPILOT_CLAIM_SEQUENCE_FILE=.claimpilot-claim-sequence
CLAIMPILOT_CLAIMS_TABLE_NAME=ClaimPilotClaims
CLAIMPILOT_EVIDENCE_BUCKET_NAME=claimpilot-evidence-<account-id>-<region>
CLAIMPILOT_FINAL_PACKET_BUCKET_NAME=claimpilot-evidence-<account-id>-<region>
CLAIMPILOT_PRESIGNED_UPLOAD_EXPIRES_SECONDS=900

# Bedrock multimodal evidence analysis. Use a vision-capable Bedrock model or inference profile.
CLAIMPILOT_EVIDENCE_ANALYSIS_MODE=auto
CLAIMPILOT_EVIDENCE_ANALYSIS_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional AWS-hosted runtime API for Pipecat Cloud deployments.
CLAIMPILOT_AWS_RUNTIME_API_URL=
CLAIMPILOT_AWS_RUNTIME_API_KEY=

# Optional CloudWatch runtime diagnostics.
CLAIMPILOT_CLOUDWATCH_LOG_GROUP_NAME=/claimpilot/runtime
CLAIMPILOT_CLOUDWATCH_LOG_STREAM_NAME=
CLAIMPILOT_CLOUDWATCH_LOG_LEVEL=INFO
