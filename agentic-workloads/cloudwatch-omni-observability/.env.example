# Copy to .env and edit. Every script in this repo sources it, and its non-empty values
# override the same variables in your shell (for example an AWS_REGION in your profile).

# Region that hosts your Omni space. Use the Region of your Omni domain AND your IAM Identity Center
# instance, so SSO works without multi-Region replication (Omni Regions: us-east-1, us-west-2, eu-west-1).
AWS_REGION=us-east-1
# Optional: named profile for a SANDBOX account.
# AWS_PROFILE=omni-sandbox

# Step 0 (00-prerequisites CDK): the Omni domain to attach the space to (name or ID; see
#   aws cloudwatchomni list-domains), and the IAM role/user ARN that gets SPACE_ADMIN. With an
#   organization domain, the space lives in a member account: set OMNI_MEMBER_ROLE_ARN and run
#   `source common/assume-member-role.sh` first. The admin principal must be in that account.
OMNI_DOMAIN_ID=
OMNI_MEMBER_ROLE_ARN=
# Identity Center groups that get access to the space (written by 00-prerequisites/enable_sso.py).
OMNI_ADMIN_GROUP_ID=
OMNI_VIEWER_GROUP_ID=
# Optional IAM role/user that also gets SPACE_ADMIN (break-glass/automation). People should use the groups above.
OMNI_ADMIN_PRINCIPAL_ARN=

# Bedrock model the support agent uses. Amazon Nova works in any account with no extra step.
# Anthropic Claude (e.g. us.anthropic.claude-haiku-4-5-20251001-v1:0) first needs the one-time
# Anthropic use-case form in the Bedrock console's model catalog for THIS account; until then
# calls fail with "Model use case details have not been submitted for this account".
MODEL_ID=us.amazon.nova-2-lite-v1:0
# Judge model for the custom LLM-as-judge evaluator (same Region, same access rules).
JUDGE_MODEL_ID=us.amazon.nova-pro-v1:0

# Optional: pin a space (00-prerequisites/write_env.sh sets it). If unset, scripts use the only ACTIVE space in AWS_REGION.
# OMNI_SPACE_ID=

# Log group that receives the shop's OTLP logs (sample 02). Step 0 creates it.
SHOP_LOG_GROUP=/omni-samples/shop

# SNS topic for Omni alerts (sample 04). Step 0 creates it, and 00-prerequisites/write_env.sh fills this in.
# ALERTS_TOPIC_ARN=
