# Local Next.js UI points to the deployed console BFF. Production uses same-origin /api/console.
NEXT_PUBLIC_CONSOLE_API_BASE=https://your-console-id.execute-api.ap-northeast-2.amazonaws.com/api/console

# Optional display/discovery metadata is consumed by the deployed BFF Lambda environment.
# BEDROCK_METER_EXTRA_USERS=alice,bob,charlie

# Optional display metadata used only by the console.
# BEDROCK_METER_USER_METADATA={"alice":{"displayName":"Alice Kim","team":"Platform"}}
