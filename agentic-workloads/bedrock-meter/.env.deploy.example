# Project settings only. AWS credentials and region come from your terminal/profile.
# For example, export AWS_PROFILE=my-profile and AWS_REGION=ap-northeast-2 in the shell.
# Do not put AWS_* or CDK_DEFAULT_* settings in this file.
# Optional: omit to auto-detect and persist the deployment host's IANA time zone.
# BEDROCK_METER_QUOTA_TIME_ZONE=Asia/Seoul
BEDROCK_METER_ADMIN_USERNAMES=alice
