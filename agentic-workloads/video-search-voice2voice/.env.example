# --- Voice pipeline -----------------------------------------------------------
DEEPGRAM_API_KEY=
# Only needed for the hosted deployment (TALK2VID_TRANSPORT=daily); see README.
DAILY_API_KEY=

# --- AWS ----------------------------------------------------------------------
TALK2VID_AWS_REGION=us-east-1
# Printed by: uv run python scripts/provision_aws.py
TALK2VID_S3_BUCKET=
# Printed by: uv run python scripts/provision_agentcore.py
# The AgentCore harness that answers questions the video cannot (web search).
TALK2VID_HARNESS_ARN=

# --- Optional overrides -------------------------------------------------------
# Fast profile: ~250ms lower time-to-first-token, slightly weaker instruction following
# TALK2VID_LLM_MODEL_ID=us.amazon.nova-lite-v1:0
# TALK2VID_TTS_VOICE=aura-2-thalia-en
# TALK2VID_PORT=7860
