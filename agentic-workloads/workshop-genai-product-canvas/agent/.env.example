# Copy to .env and fill in. `source .env` before running the agent.

# --- Model ---
export AWS_REGION=us-east-1
export BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# --- Tool mode: "local" (read ./data) or "gateway" (remote AgentCore Gateway) ---
export TOOL_MODE=local

# --- Remote tools (only needed when TOOL_MODE=gateway) ---
# Get these from `infra/create_gateway.py` output.
export AGENTCORE_GATEWAY_URL=https://your-gateway-id.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp

# Option A: paste a pre-fetched bearer token directly
# export AGENTCORE_GATEWAY_TOKEN=eyJ...

# Option B: let gateway_client.py fetch one via Cognito client-credentials
export COGNITO_TOKEN_URL=https://your-domain.auth.us-east-1.amazoncognito.com/oauth2/token
export COGNITO_CLIENT_ID=your-m2m-client-id
export COGNITO_CLIENT_SECRET=your-m2m-client-secret
export COGNITO_SCOPE=your-resource-server/gateway.invoke
