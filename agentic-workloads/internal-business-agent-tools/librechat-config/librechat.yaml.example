# LibreChat MCP integration with AgentCore Gateway (example)
#
# Copy this file to `librechat.yaml` and fill in the placeholders below
# from your CDK deployment outputs (or SSM parameters under /internalagent/*).
#
# Notes:
# - LibreChat does NOT support OAuth Dynamic Client Registration (DCR), so the
#   `oauth.client_id` / `client_secret` MUST be pre-configured here.
# - The Cognito App Client used for LibreChat must have:
#     * authorization_code flow enabled
#     * callback URL: http://localhost:3080/oauth/callback (adjust for your DOMAIN_SERVER)
#     * scopes: openid, mcp/access

version: 1.3.11
cache: true

registration:
  socialLogins: ['openid']

mcpSettings:
  allowedDomains:
    - '*.amazonaws.com'
    - '*.amazoncognito.com'

mcpServers:
  internal-tools:
    type: streamable-http
    # Replace <GATEWAY_URL> with the value of CDK output `GatewayUrl`.
    url: https://<GATEWAY_URL>/mcp
    timeout: 60000
    oauth:
      # Replace with the LibreChat (authorization_code) Cognito App Client ID/Secret.
      client_id: "<COGNITO_CLIENT_ID>"
      client_secret: "<COGNITO_CLIENT_SECRET>"
      # Replace <COGNITO_DOMAIN_PREFIX> with your Cognito domain prefix
      # (e.g. internal-agent-mcp-<ACCOUNT_ID>).
      authorization_url: "https://<COGNITO_DOMAIN_PREFIX>.auth.ap-northeast-1.amazoncognito.com/oauth2/authorize"
      token_url: "https://<COGNITO_DOMAIN_PREFIX>.auth.ap-northeast-1.amazoncognito.com/oauth2/token"
      scope: "openid mcp/access"

endpoints:
  bedrock:
    # Use Bedrock inference profile IDs (jp.* / apac.*), NOT direct model IDs,
    # because the underlying models are on-demand-only otherwise.
    models:
      - "jp.anthropic.claude-sonnet-4-6"
      - "apac.anthropic.claude-sonnet-4-20250514-v1:0"
