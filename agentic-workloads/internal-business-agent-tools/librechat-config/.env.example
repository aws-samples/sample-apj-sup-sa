# LibreChat .env example for the AgentCore Gateway MCP integration.
# Copy to `librechat/.env` (or your LibreChat clone's .env) and fill in the values.
#
# DO NOT commit the populated .env — secrets must stay local.

HOST=0.0.0.0
PORT=3080
DOMAIN_SERVER=http://localhost:3080
DOMAIN_CLIENT=http://localhost:3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=true

# LibreChat-internal encryption / JWT secrets — generate fresh values
# (e.g. `openssl rand -hex 32`) per environment.
CREDS_KEY=<HEX_64_CHARS>
CREDS_IV=<HEX_32_CHARS>
JWT_SECRET=<HEX_64_CHARS>
JWT_REFRESH_SECRET=<HEX_64_CHARS>

# AWS Bedrock — prefer instance/role credentials over static keys.
# If you must use static keys for local dev, never commit them.
BEDROCK_AWS_DEFAULT_REGION=ap-northeast-1
BEDROCK_AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
BEDROCK_AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
BEDROCK_AWS_SESSION_TOKEN=<AWS_SESSION_TOKEN_IF_USING_STS>

# OpenID Connect (Cognito) — used for LibreChat user login (social login).
# This is a *separate* Cognito App Client from the MCP `internal-tools` client
# unless you intentionally share one.
OPENID_CLIENT_ID=<COGNITO_CLIENT_ID>
OPENID_CLIENT_SECRET=<COGNITO_CLIENT_SECRET>
OPENID_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/<COGNITO_USER_POOL_ID>
OPENID_SCOPE=openid email profile mcp/access
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_SESSION_SECRET=<HEX_48_CHARS>
OPENID_BUTTON_LABEL=Log in with Cognito
