# Optional overrides for setup-backend.sh
#
# Usually you can rely on normal AWS CLI auth (`aws configure`, `AWS_PROFILE`,
# SSO, etc.). This file is only needed if you want per-project overrides.

# export AWS_PROFILE=your-profile
# export AWS_DEFAULT_REGION=us-east-1

export TF_STATE_BUCKET_PREFIX=v1-tfstate
export TF_STATE_LOCK_TABLE=v1-tfstate-lock
export TF_STATE_KEY=v1/infrastructure/terraform.tfstate
export TF_STATE_REGION=us-east-1
