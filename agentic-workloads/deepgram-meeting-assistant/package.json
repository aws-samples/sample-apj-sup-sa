{
  "name": "meeting-assistant",
  "version": "1.0.1",
  "description": "Meeting Assistant - Transcribe, Record, and Summarize Meetings",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "dev:web": "vite --config vite.renderer.config.ts",
    "package": "electron-forge package",
    "make:mac": "electron-forge make --platform darwin",
    "release:mac": "bash scripts/release.sh",
    "build": "tsc",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git@ssh.gitlab.aws.dev:korea-sup-sa/meeting-assistant.git"
  },
  "keywords": [
    "electron",
    "meeting",
    "transcribe",
    "assistant"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/rebuild": "^4.0.2",
    "@playwright/test": "^1.57.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.2",
    "dotenv": "^17.2.3",
    "electron": "^39.2.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.966.0",
    "@aws-sdk/client-s3": "^3.972.0",
    "@aws-sdk/client-transcribe": "^3.972.0",
    "@aws-sdk/client-transcribe-streaming": "^3.966.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "better-sqlite3": "^12.6.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "uuid": "^13.0.0",
