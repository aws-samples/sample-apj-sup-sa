        </mxCell>
        <mxCell id="s_step_t11" value="When digest delivery is on, &lt;b&gt;Amazon EventBridge&lt;/b&gt; runs a scheduler function every 15 minutes that queues each digest that is due on an &lt;b&gt;Amazon Simple Queue Service (Amazon SQS)&lt;/b&gt; queue. A sender function builds each digest with what its reader may see and posts it to &lt;b&gt;Slack&lt;/b&gt; with a bot token or webhook URL kept in &lt;b&gt;AWS Secrets Manager&lt;/b&gt;, or emails it through &lt;b&gt;Amazon Simple Email Service (Amazon SES)&lt;/b&gt;. SES bounces and complaints reach a feedback function through &lt;b&gt;Amazon SNS&lt;/b&gt;, which stops that subscription." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=13;fontColor=#232F3E;spacing=0;" vertex="1" parent="s1">
          <mxGeometry x="1360" y="992" width="520" height="122" as="geometry" />
        </mxCell>
      </root>
