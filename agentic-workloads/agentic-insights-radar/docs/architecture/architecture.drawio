        </mxCell>
        <mxCell id="s_badge3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="538.0" y="287.0" width="22" height="22" as="geometry" />
