        <mxCell id="s_badge5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="727.0" y="391.0" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s_badge6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="1014.0" y="438.0" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s_badge7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="585.0" y="637.0" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s_badge8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="926.0" y="702.0" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s_badge9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="350.0" y="664.0" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s_badge10" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="713.0" y="993" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s_bg_panel" value="" style="rounded=0;strokeColor=none;fillColor=#E9EBED;" vertex="1" parent="s1">
          <mxGeometry x="1300" y="0" width="620" height="1136" as="geometry" />
        </mxCell>
        <mxCell id="s_title" value="Agentic Insights Radar on AWS" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=34;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="s1">
          <mxGeometry x="20" y="18" width="1260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s_subtitle" value="&lt;b&gt;Scheduled AI agents that turn public sources into cited signals, trends, gaps and content ideas&lt;/b&gt;&lt;br&gt;This architecture shows how to run budgeted agent modules on Amazon Bedrock AgentCore, keep their findings in a knowledge graph on Amazon DynamoDB with Amazon S3 Vectors search, and let users explore them through a web app, a chat assistant and an MCP server." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=15;fontColor=#232F3E;" vertex="1" parent="s1">
          <mxGeometry x="20" y="70" width="1260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s_title_rule" value="" style="line;strokeWidth=2;strokeColor=#232F3E;html=1;" vertex="1" parent="s1">
          <mxGeometry x="20" y="146" width="1260" height="4" as="geometry" />
        </mxCell>
        <mxCell id="s_step_n1" value="1" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="1320" y="24" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s_step_t1" value="Users open the web app through &lt;b&gt;Amazon CloudFront&lt;/b&gt;, which serves the single-page app from a private &lt;b&gt;Amazon Simple Storage Service (Amazon S3)&lt;/b&gt; bucket. &lt;b&gt;AWS WAF&lt;/b&gt; filters every request with a per-IP rate limit and AWS managed rule groups." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=13;fontColor=#232F3E;spacing=0;" vertex="1" parent="s1">
          <mxGeometry x="1360" y="22" width="520" height="61" as="geometry" />
        </mxCell>
        <mxCell id="s_step_n2" value="2" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="1320" y="121" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s_step_t2" value="Users sign in with the &lt;b&gt;Amazon Cognito&lt;/b&gt; hosted UI and TOTP multi-factor authentication. Administrators invite users and give each a role: viewer, editor or administrator." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=13;fontColor=#232F3E;spacing=0;" vertex="1" parent="s1">
          <mxGeometry x="1360" y="119" width="520" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s_step_n3" value="3" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="1320" y="201" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s_step_t3" value="CloudFront forwards /api/* to &lt;b&gt;Amazon API Gateway&lt;/b&gt;, which checks the user&amp;#x27;s Cognito token. An &lt;b&gt;AWS Lambda&lt;/b&gt; function handles the request after checking the user&amp;#x27;s role." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=13;fontColor=#232F3E;spacing=0;" vertex="1" parent="s1">
          <mxGeometry x="1360" y="199" width="520" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s_step_n4" value="4" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="1320" y="281" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s_step_t4" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt; stores the knowledge graph in one table and modules, sources, runs, budgets, radars and the audit log in another. An S3 assets bucket holds uploaded documents and drafts, encrypted with an &lt;b&gt;AWS Key Management Service (AWS KMS)&lt;/b&gt; customer managed key." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=13;fontColor=#232F3E;spacing=0;" vertex="1" parent="s1">
          <mxGeometry x="1360" y="279" width="520" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s_step_n5" value="5" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="1320" y="395" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s_step_t5" value="A &lt;b&gt;DynamoDB stream&lt;/b&gt; triggers an indexer function that embeds each changed entry with &lt;b&gt;Amazon Titan Text Embeddings V2&lt;/b&gt; and writes it to an &lt;b&gt;Amazon S3 Vectors&lt;/b&gt; index for hybrid search." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=13;fontColor=#232F3E;spacing=0;" vertex="1" parent="s1">
          <mxGeometry x="1360" y="393" width="520" height="61" as="geometry" />
        </mxCell>
        <mxCell id="s_step_n6" value="6" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="1320" y="492" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s_step_t6" value="A crawler function copies each product&amp;#x27;s public documentation into the assets bucket. An &lt;b&gt;Amazon Bedrock knowledge base&lt;/b&gt; indexes those pages and uploaded documents into a second &lt;b&gt;S3 Vectors&lt;/b&gt; index." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=13;fontColor=#232F3E;spacing=0;" vertex="1" parent="s1">
          <mxGeometry x="1360" y="490" width="520" height="61" as="geometry" />
        </mxCell>
        <mxCell id="s_step_n7" value="7" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="1320" y="589" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s_step_t7" value="&lt;b&gt;Amazon EventBridge&lt;/b&gt; runs a sweep function every 5 minutes. It starts an &lt;b&gt;AWS Step Functions&lt;/b&gt; execution for each enabled module that is due and within its daily token budget." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=13;fontColor=#232F3E;spacing=0;" vertex="1" parent="s1">
          <mxGeometry x="1360" y="587" width="520" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s_step_n8" value="8" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="1320" y="669" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s_step_t8" value="Step Functions starts the module agent in &lt;b&gt;Amazon Bedrock AgentCore Runtime&lt;/b&gt; and waits up to 8 hours for it to finish. The agent, built with &lt;b&gt;Strands Agents&lt;/b&gt; on an &lt;b&gt;Amazon Bedrock&lt;/b&gt; model with &lt;b&gt;Amazon Bedrock Guardrails&lt;/b&gt;, reads and writes the graph only through the API&amp;#x27;s signed agent tool routes, and can use &lt;b&gt;AgentCore web search&lt;/b&gt;, &lt;b&gt;Browser&lt;/b&gt; and &lt;b&gt;Code Interpreter&lt;/b&gt; when granted." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=13;fontColor=#232F3E;spacing=0;" vertex="1" parent="s1">
          <mxGeometry x="1360" y="667" width="520" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s_step_n9" value="9" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="1320" y="800" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s_step_t9" value="The chat assistant, a second agent in &lt;b&gt;AgentCore Runtime&lt;/b&gt;, answers users&amp;#x27; questions with their own Cognito token, so it sees only what the user may see. &lt;b&gt;AgentCore Memory&lt;/b&gt; keeps the conversation&amp;#x27;s short-term history." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=13;fontColor=#232F3E;spacing=0;" vertex="1" parent="s1">
          <mxGeometry x="1360" y="798" width="520" height="61" as="geometry" />
        </mxCell>
        <mxCell id="s_step_n10" value="10" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="1320" y="897" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s_step_t10" value="&lt;b&gt;Amazon CloudWatch&lt;/b&gt; alarms on function errors, failed or timed-out runs and dead-letter queues notify an &lt;b&gt;Amazon Simple Notification Service (Amazon SNS)&lt;/b&gt; topic, with an optional email subscription." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=13;fontColor=#232F3E;spacing=0;" vertex="1" parent="s1">
          <mxGeometry x="1360" y="895" width="520" height="61" as="geometry" />
        </mxCell>
        <mxCell id="s_logo" value="" style="sketch=0;html=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=none;fillColor=none;verticalAlign=top;align=left;" vertex="1" parent="s1">
          <mxGeometry x="20" y="1066" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s_footer" value="&lt;i&gt;Reviewed for technical accuracy October 6, 2026&lt;/i&gt;&lt;br&gt;&amp;#169; 2026, Amazon Web Services, Inc. or its affiliates. All rights reserved." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=12;fontColor=#545B64;" vertex="1" parent="s1">
          <mxGeometry x="80" y="1070" width="700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s_ra" value="AWS Reference Architecture" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Amazon Ember;fontSize=22;fontStyle=1;fontColor=#FF9900;align=right;" vertex="1" parent="s1">
          <mxGeometry x="800" y="1074" width="480" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s_g_digest" value="Digest delivery (optional)" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#7D8998;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=1;fontStyle=1;fontSize=12;fontColor=#232F3E;fontFamily=Amazon Ember;" vertex="1" parent="s1">
          <mxGeometry x="248" y="806" width="850" height="170" as="geometry" />
        </mxCell>
        <mxCell id="s_dg_rule" value="&lt;b&gt;Amazon EventBridge&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Every 15 minutes&lt;/font&gt;&lt;/i&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontFamily=Amazon Ember;fontSize=12;aspect=fixed;verticalLabelPosition=top;verticalAlign=bottom;labelPosition=center;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="s1">
          <mxGeometry x="310" y="868" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="s_dg_schedule" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Digest schedule&lt;/font&gt;&lt;/i&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontFamily=Amazon Ember;fontSize=12;aspect=fixed;verticalLabelPosition=top;verticalAlign=bottom;labelPosition=center;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="s1">
          <mxGeometry x="430" y="868" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="s_dg_queue" value="&lt;b&gt;Amazon SQS&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Digest queue + DLQ&lt;/font&gt;&lt;/i&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontFamily=Amazon Ember;fontSize=12;aspect=fixed;verticalLabelPosition=top;verticalAlign=bottom;labelPosition=center;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="s1">
          <mxGeometry x="550" y="868" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="s_dg_send" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Digest send&lt;/font&gt;&lt;/i&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontFamily=Amazon Ember;fontSize=12;aspect=fixed;verticalLabelPosition=top;verticalAlign=bottom;labelPosition=center;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="s1">
          <mxGeometry x="670" y="868" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="s_dg_ses" value="&lt;b&gt;Amazon SES&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Email (optional)&lt;/font&gt;&lt;/i&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontFamily=Amazon Ember;fontSize=12;aspect=fixed;verticalLabelPosition=top;verticalAlign=bottom;labelPosition=center;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_email_service;" vertex="1" parent="s1">
          <mxGeometry x="790" y="868" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="s_dg_sns" value="&lt;b&gt;Amazon SNS&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Bounces, complaints&lt;/font&gt;&lt;/i&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontFamily=Amazon Ember;fontSize=12;aspect=fixed;verticalLabelPosition=top;verticalAlign=bottom;labelPosition=center;align=center;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="s1">
          <mxGeometry x="910" y="868" width="48" height="48" as="geometry" />
