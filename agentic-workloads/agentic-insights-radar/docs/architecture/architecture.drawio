        <mxCell id="s_e_sweep_sfn" value="Start run" style="edgeStyle=none;html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Amazon Ember;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="s1" source="s_sweep" target="s_sfn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_e_sfn_module" value="Invoke +&lt;br&gt;task token" style="edgeStyle=none;html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Amazon Ember;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="s1" source="s_sfn" target="s_module">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_e_module_model" value="Model + guardrail" style="edgeStyle=none;html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Amazon Ember;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="s1" source="s_module" target="s_models">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_e_module_tools" value="Use" style="edgeStyle=none;html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Amazon Ember;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7423;entryDx=0;entryDy=0;" edge="1" parent="s1" source="s_module" target="s_g_tools">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_e_tools_web" value="Search,&lt;br&gt;browse" style="edgeStyle=none;html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Amazon Ember;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.4845;exitDx=0;exitDy=0;entryX=0;entryY=0.7636;entryDx=0;entryDy=0;" edge="1" parent="s1" source="s_g_tools" target="s_internet">
          <mxGeometry relative="1" x="0.326" as="geometry" />
        </mxCell>
