          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_badge1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;fontFamily=Amazon Ember;" vertex="1" parent="s1">
