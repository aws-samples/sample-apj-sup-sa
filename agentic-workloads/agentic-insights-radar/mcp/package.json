{
  "name": "insights-radar-mcp",
  "version": "2.0.0",
  "description": "MCP server (stdio) for Agentic Insights Radar: search insights, radars and the knowledge graph from an AI assistant",
  "license": "MIT-0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "insights-radar-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "deployment.json"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src test && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@smithy/signature-v4": "5.7.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.0.5"
  }
}
